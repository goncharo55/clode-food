// 期間限定カレンダー — データモデル
// 詳細は docs/data-model.md を参照

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  draft
  pending_review
  published
  archived
}

model Chain {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  category        String     @default("other")
  officialSiteUrl String
  logoImageUrl    String?
  description     String?
  campaigns       Campaign[]
  stores          Store[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Campaign {
  id                 String          @id @default(cuid())
  chainId            String
  chain              Chain           @relation(fields: [chainId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  startDate          DateTime
  endDate            DateTime?
  targetProducts     Json
  imageUrl           String?
  sourceUrl          String?
  status             CampaignStatus  @default(draft)
  featured           Boolean         @default(false)
  extractionMetadata Json?
  areas              CampaignArea[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([status])
  @@index([chainId])
  @@index([startDate])
  @@index([endDate])
}

model Area {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  region         String?
  lat            Float?
  lng            Float?
  stationAliases StationAlias[]
  campaigns      CampaignArea[]
  stores         Store[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model StationAlias {
  id          String @id @default(cuid())
  stationName String @unique
  areaId      String
  area        Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
}

model CampaignArea {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  areaId     String
  area       Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([campaignId, areaId])
}

// Stage B（将来）用のプレースホルダー。MVPのUI/検索ロジックからは未使用。
model Store {
  id        String   @id @default(cuid())
  chainId   String
  chain     Chain    @relation(fields: [chainId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  lat       Float?
  lng       Float?
  areaId    String?
  area      Area?    @relation(fields: [areaId], references: [id])
  createdAt DateTime @default(now())
}
